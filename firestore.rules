rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isActiveUser() {
      return isSignedIn()
        && userDocExists()
        && (!('active' in userDoc()) || userDoc().active == true);
    }
    function usesCustomModules() {
      return userDocExists()
        && ('moduleAccess' in userDoc())
        && userDoc().moduleAccess is list
        && userDoc().moduleAccess.size() > 0;
    }
    function hasModuleAccess(permission) {
      return usesCustomModules() && permission in userDoc().moduleAccess;
    }
    // Mirrors src/lib/permissions.ts role defaults.
    function hasDefaultPermission(p) {
      return userDoc().role == 'Admin'
        || (userDoc().role == 'QA Manager' && p in [
          'masters.manage', 'studies.create', 'studies.edit', 'receiving.perform',
          'charging.perform', 'withdrawal.perform', 'movement.perform',
          'reconciliation.perform', 'disposal.perform', 'control.collect',
          'control.perform', 'chamber.ops', 'protocol.manage', 'analysis.perform',
          'approve.records', 'reports.view', 'inventory.view', 'audit.view'
        ])
        || (userDoc().role == 'QA Executive' && p in [
          'studies.create', 'studies.edit', 'receiving.perform', 'charging.perform',
          'withdrawal.perform', 'movement.perform', 'reconciliation.perform',
          'control.collect', 'control.perform', 'protocol.manage', 'analysis.perform',
          'reports.view', 'inventory.view'
        ])
        || (userDoc().role == 'QA User' && p in [
          'receiving.perform', 'control.collect', 'withdrawal.perform',
          'reports.view', 'inventory.view', 'analysis.perform'
        ])
        || (userDoc().role == 'QC User' && p in [
          'inventory.view', 'analysis.perform', 'reports.view'
        ])
        || (userDoc().role == 'Engineering User' && p in [
          'chamber.ops', 'inventory.view', 'reports.view'
        ])
        || (userDoc().role == 'Read Only' && p in [
          'inventory.view', 'reports.view'
        ]);
    }
    function hasPermission(p) {
      return isActiveUser() && (
        hasModuleAccess(p)
        || (!usesCustomModules() && hasDefaultPermission(p))
      );
    }
    function canManageUsers() {
      return hasPermission('users.manage');
    }
    function canManageMasters() {
      return hasPermission('masters.manage');
    }
    function canReadInventory() {
      return hasPermission('inventory.view')
        || hasPermission('charging.perform')
        || hasPermission('receiving.perform')
        || hasPermission('studies.create')
        || hasPermission('reports.view');
    }
    function canMutateInventoryQty() {
      return hasPermission('charging.perform')
        || hasPermission('withdrawal.perform')
        || hasPermission('movement.perform')
        || hasPermission('disposal.perform')
        || hasPermission('reconciliation.perform')
        || hasPermission('receiving.perform')
        || hasPermission('studies.create')
        || hasPermission('studies.edit');
    }
    function canControl() {
      return hasPermission('control.perform') || hasPermission('control.collect');
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && docId == 'bootstrap'
        && bootstrapOpen();
      allow create: if canManageUsers() && docId == 'organization';
      // Bootstrap must stay once written so Admin self-provisioning cannot be re-opened.
      allow update: if canManageUsers() && docId != 'bootstrap';
      allow delete: if canManageUsers() && docId != 'bootstrap';
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || canManageUsers();
      allow create: if canManageUsers()
        || (
          bootstrapOpen()
          && isSelf(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'Admin'
          && request.resource.data.email == request.auth.token.email
        );
      allow update: if canManageUsers()
        || (
          isSelf(userId)
          && isActiveUser()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'moduleAccess', 'active'])
        );
      allow delete: if canManageUsers();
    }

    match /counters/{docId} {
      allow read: if isActiveUser();
      allow write: if canMutateInventoryQty() || canControl() || hasPermission('chamber.ops')
        || hasPermission('analysis.perform') || hasPermission('protocol.manage')
        || canManageUsers();
    }

    match /products/{docId} {
      allow read: if canReadInventory() || canManageMasters() || canControl();
      allow write: if canManageMasters();
    }
    match /batches/{docId} {
      allow read: if canReadInventory() || canManageMasters() || canControl();
      allow write: if canManageMasters();
    }
    match /controlSampleProducts/{docId} {
      allow read: if canControl() || canManageMasters();
      allow write: if hasPermission('control.perform') || canManageMasters();
    }
    match /controlSampleBatches/{docId} {
      allow read: if canControl() || canManageMasters();
      allow write: if hasPermission('control.perform') || canManageMasters();
    }
    match /studyTypes/{docId} {
      allow read: if canReadInventory() || canManageMasters();
      allow write: if canManageMasters();
    }
    match /storageConditions/{docId} {
      allow read: if canReadInventory() || canManageMasters();
      allow write: if canManageMasters();
    }
    match /pullPoints/{docId} {
      allow read: if canReadInventory() || canManageMasters();
      allow write: if canManageMasters();
    }
    match /chambers/{docId} {
      allow read: if canReadInventory() || canManageMasters() || hasPermission('movement.perform') || hasPermission('chamber.ops');
      allow create, delete: if canManageMasters();
      allow update: if canManageMasters() || canMutateInventoryQty() || hasPermission('chamber.ops');
    }
    match /storageLocations/{docId} {
      allow read: if canReadInventory() || canManageMasters() || hasPermission('movement.perform');
      allow write: if canManageMasters();
    }
    match /units/{docId} {
      allow read: if canReadInventory() || canManageMasters() || canControl();
      allow write: if canManageMasters();
    }

    match /stabilityStudies/{docId} {
      allow read: if canReadInventory();
      allow create: if hasPermission('studies.create') || hasPermission('charging.perform');
      allow update: if canMutateInventoryQty();
      allow delete: if false;
    }
    match /stabilitySamples/{docId} {
      allow read: if canReadInventory();
      allow create: if hasPermission('charging.perform') || hasPermission('receiving.perform') || hasPermission('studies.create');
      allow update: if canMutateInventoryQty();
      allow delete: if false;
    }
    match /studyPullPoints/{docId} {
      allow read: if canReadInventory() || hasPermission('withdrawal.perform');
      allow create: if hasPermission('charging.perform') || hasPermission('studies.create');
      allow update: if hasPermission('withdrawal.perform') || hasPermission('charging.perform') || hasPermission('studies.edit');
      allow delete: if false;
    }
    match /sampleWithdrawals/{docId} {
      allow read: if canReadInventory() || hasPermission('withdrawal.perform') || hasPermission('analysis.perform');
      allow create: if hasPermission('withdrawal.perform');
      allow update, delete: if false;
    }
    match /sampleMovements/{docId} {
      allow read: if canReadInventory() || hasPermission('movement.perform');
      allow create: if hasPermission('movement.perform');
      allow update, delete: if false;
    }
    match /sampleDisposals/{docId} {
      allow read: if canReadInventory() || hasPermission('disposal.perform');
      allow create: if hasPermission('disposal.perform');
      allow update, delete: if false;
    }
    match /inventoryReconciliations/{docId} {
      allow read: if canReadInventory() || hasPermission('reconciliation.perform');
      allow create, update: if hasPermission('reconciliation.perform');
      allow delete: if false;
    }
    match /inventoryTransactions/{docId} {
      allow read: if canReadInventory() || hasPermission('reports.view');
      allow create: if canMutateInventoryQty();
      allow update, delete: if false;
    }
    match /inventoryAlerts/{docId} {
      allow read: if canReadInventory() || hasPermission('reports.view');
      allow write: if canMutateInventoryQty() || hasPermission('reports.view') || hasPermission('chamber.ops');
    }
    match /auditLogs/{docId} {
      allow read: if hasPermission('audit.view');
      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['action', 'userId', 'createdAt']);
      allow update, delete: if false;
    }

    match /studyReasons/{docId} {
      allow read: if canReadInventory() || canManageMasters();
      allow write: if canManageMasters();
    }
    match /packagingMaterials/{docId} {
      allow read: if canReadInventory() || canManageMasters() || canControl();
      allow write: if canManageMasters();
    }
    match /markets/{docId} {
      allow read: if canManageMasters() || canControl() || canReadInventory();
      allow write: if canManageMasters();
    }
    match /packSizes/{docId} {
      allow read: if canManageMasters() || canControl() || canReadInventory();
      allow write: if canManageMasters();
    }
    match /dailyCollectionRecords/{docId} {
      allow read: if canControl() || hasPermission('inventory.view') || hasPermission('receiving.perform');
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /sampleReceipts/{docId} {
      allow read: if canReadInventory() || hasPermission('receiving.perform') || hasPermission('charging.perform');
      allow create, update: if hasPermission('receiving.perform') || hasPermission('charging.perform');
      allow delete: if false;
    }
    match /controlSamples/{docId} {
      allow read: if canControl() || hasPermission('inventory.view');
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleCollections/{docId} {
      allow read: if canControl() || hasPermission('inventory.view');
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleObservations/{docId} {
      allow read: if canControl();
      allow create, update: if hasPermission('control.perform');
      allow delete: if false;
    }
    match /controlSampleWithdrawals/{docId} {
      allow read: if canControl() || hasPermission('approve.records');
      allow create, update: if hasPermission('control.perform') || hasPermission('approve.records');
      allow delete: if false;
    }
    match /controlSampleMovements/{docId} {
      allow read: if canControl();
      allow create: if hasPermission('control.perform');
      allow update, delete: if false;
    }
    match /controlSampleDestructions/{docId} {
      allow read: if canControl() || hasPermission('disposal.perform');
      allow create, update: if hasPermission('control.perform') || hasPermission('disposal.perform');
      allow delete: if false;
    }
    match /controlSampleDestructionLogs/{docId} {
      allow read: if canControl() || hasPermission('disposal.perform');
      allow create: if hasPermission('control.perform') || hasPermission('disposal.perform');
      allow update, delete: if false;
    }
    match /controlSampleTransactions/{docId} {
      allow read: if canControl() || hasPermission('reports.view');
      allow create: if canControl();
      allow update, delete: if false;
    }
    match /controlSampleLocations/{docId} {
      allow read: if canControl();
      allow create, update: if hasPermission('control.perform');
      allow delete: if false;
    }
    match /controlSampleBoxes/{docId} {
      allow read: if canControl();
      allow create, update: if hasPermission('control.perform');
      allow delete: if false;
    }
    match /controlSampleQuantityMasters/{docId} {
      allow read: if canControl() || canManageMasters();
      allow create, update: if hasPermission('control.perform') || canManageMasters();
      allow delete: if false;
    }
    match /controlSampleObservationParameters/{docId} {
      allow read: if canControl();
      allow create, update: if hasPermission('control.perform');
      allow delete: if false;
    }
    match /controlSampleHolds/{docId} {
      allow read: if canControl();
      allow create, update: if hasPermission('control.perform');
      allow delete: if false;
    }
    match /controlSampleBoxCategories/{docId} {
      allow read: if canControl();
      allow create, update: if hasPermission('control.perform');
      allow delete: if false;
    }
    match /analysisRequests/{docId} {
      allow read: if hasPermission('analysis.perform') || hasPermission('withdrawal.perform') || hasPermission('reports.view') || canReadInventory();
      allow create, update: if hasPermission('analysis.perform') || hasPermission('withdrawal.perform');
      allow delete: if false;
    }
    match /chamberAlarms/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create, update: if hasPermission('chamber.ops');
      allow delete: if false;
    }
    match /chamberExcursions/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create, update: if hasPermission('chamber.ops');
      allow delete: if false;
    }
    match /chamberCleaning/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create: if hasPermission('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberCalibration/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create: if hasPermission('chamber.ops');
      allow update, delete: if false;
    }
    match /temperatureMappings/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create: if hasPermission('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberMaintenance/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create: if hasPermission('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberEvents/{docId} {
      allow read: if hasPermission('chamber.ops') || canReadInventory();
      allow create: if hasPermission('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberDataLogs/{docId} {
      allow read: if hasPermission('chamber.ops') || hasPermission('reports.view');
      allow create: if hasPermission('chamber.ops');
      allow update, delete: if false;
    }
    match /electronicSignatures/{docId} {
      allow read: if isActiveUser();
      allow create: if hasPermission('approve.records');
      allow update, delete: if false;
    }
    match /stabilityProtocols/{docId} {
      allow read: if hasPermission('protocol.manage') || canReadInventory();
      allow create, update: if hasPermission('protocol.manage');
      allow delete: if false;
    }
    match /stabilityReports/{docId} {
      allow read: if hasPermission('protocol.manage') || hasPermission('reports.view');
      allow create, update: if hasPermission('protocol.manage');
      allow delete: if false;
    }
    match /waterLossStudies/{docId} {
      allow read: if hasPermission('protocol.manage') || canReadInventory();
      allow create: if hasPermission('protocol.manage');
      allow update, delete: if false;
    }
    match /sopTasks/{docId} {
      allow read: if isActiveUser();
      allow write: if hasPermission('chamber.ops') || hasPermission('inventory.view');
    }
  }
}
