rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasRole(roles) {
      return isSignedIn() && userDocExists() && userDoc().role in roles;
    }
    function isAdmin() {
      return hasRole(['Admin']);
    }
    function usesCustomModules() {
      return userDocExists()
        && ('moduleAccess' in userDoc())
        && userDoc().moduleAccess is list
        && userDoc().moduleAccess.size() > 0;
    }
    function hasModuleAccess(permission) {
      return usesCustomModules() && permission in userDoc().moduleAccess;
    }
    // Matches app effectivePermissions: custom moduleAccess OR Admin role defaults.
    function canManageUsers() {
      return isSignedIn() && userDocExists() && (
        hasModuleAccess('users.manage')
        || (!usesCustomModules() && userDoc().role == 'Admin')
      );
    }
    function isQAManagerOrAdmin() {
      return hasRole(['Admin', 'QA Manager']);
    }
    function isQAStaff() {
      return hasRole(['Admin', 'QA Manager', 'QA Executive', 'QA User', 'QC User', 'Engineering User', 'Read Only']);
    }
    // App role defaults live in the client. Firestore still allows any provisioned QA staff
    // so pages do not fail when a user has no custom moduleAccess list.
    function canControl() {
      return isQAStaff() || hasModuleAccess('control.perform') || hasModuleAccess('control.collect');
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      // First signed-in bootstrap admin may close public profile creation.
      allow create: if isSignedIn()
        && docId == 'bootstrap'
        && bootstrapOpen();
      allow create: if canManageUsers() && docId == 'organization';
      allow update, delete: if canManageUsers();
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || canManageUsers();
      // User managers provision accounts. One-time bootstrap: first Admin may self-create while open.
      allow create: if canManageUsers()
        || (
          bootstrapOpen()
          && isSelf(userId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'Admin'
          && request.resource.data.email == request.auth.token.email
        );
      allow update: if canManageUsers()
        || (
          isSelf(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'moduleAccess'])
        );
      allow delete: if canManageUsers();
    }

    match /counters/{docId} {
      allow read, write: if isQAStaff();
    }

    match /products/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create');
      allow write: if isQAManagerOrAdmin() || hasModuleAccess('masters.manage');
    }
    match /batches/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create');
      allow write: if isQAManagerOrAdmin() || hasModuleAccess('masters.manage');
    }
    match /studyTypes/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create');
      // App permission: masters.manage (Admin role default, or custom moduleAccess).
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }
    match /storageConditions/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create');
      // App permission: masters.manage (Admin role default, or custom moduleAccess).
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }
    match /pullPoints/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create');
      // App permission: masters.manage (Admin role default, or custom moduleAccess).
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }
    match /chambers/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create') || hasModuleAccess('movement.perform');
      // Master create/delete: Admin or masters.manage. Inventory workflows (QA staff) update usedCapacity.
      allow create, delete: if isAdmin() || hasModuleAccess('masters.manage');
      allow update: if isQAStaff() || hasModuleAccess('masters.manage');
    }
    match /storageLocations/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create') || hasModuleAccess('movement.perform');
      // App permission: masters.manage (Admin role default, or custom moduleAccess).
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }
    match /units/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage') || hasModuleAccess('inventory.view') || hasModuleAccess('charging.perform') || hasModuleAccess('studies.create');
      // App permission: masters.manage (Admin role default, or custom moduleAccess).
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }

    match /stabilityStudies/{docId} {
      allow read: if isQAStaff();
      allow create: if isQAManagerOrAdmin()
        || hasModuleAccess('studies.create')
        || hasModuleAccess('charging.perform');
      // Withdrawals / adjustments update study quantity balances.
      allow update: if isQAStaff();
      allow delete: if false;
    }
    match /stabilitySamples/{docId} {
      allow read: if isQAStaff();
      allow create, update: if isQAStaff();
      allow delete: if false;
    }
    match /studyPullPoints/{docId} {
      allow read: if isQAStaff();
      allow create, update: if isQAStaff();
      allow delete: if false;
    }
    match /sampleWithdrawals/{docId} {
      allow read: if isQAStaff();
      allow create: if isQAStaff();
      allow update, delete: if false;
    }
    match /sampleMovements/{docId} {
      allow read: if isQAStaff();
      // App permission: movement.perform (role default for QA Manager/Admin, or custom moduleAccess).
      allow create: if isQAManagerOrAdmin() || hasModuleAccess('movement.perform');
      allow update, delete: if false;
    }
    match /sampleDisposals/{docId} {
      allow read: if isQAStaff();
      // App permission: disposal.perform (role default for QA Manager/Admin, or custom moduleAccess).
      allow create: if isQAManagerOrAdmin() || hasModuleAccess('disposal.perform');
      allow update, delete: if false;
    }
    match /inventoryReconciliations/{docId} {
      allow read: if isQAStaff();
      allow create, update: if isQAManagerOrAdmin();
      allow delete: if false;
    }
    match /inventoryTransactions/{docId} {
      allow read: if isQAStaff();
      allow create: if isQAStaff();
      allow update, delete: if false;
    }
    match /inventoryAlerts/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('reports.view');
      allow write: if isQAStaff() || hasModuleAccess('reports.view');
    }
    match /auditLogs/{docId} {
      allow read: if isQAManagerOrAdmin() || hasModuleAccess('audit.view');
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /studyReasons/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage');
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }
    match /packagingMaterials/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('masters.manage');
      allow write: if isAdmin() || hasModuleAccess('masters.manage');
    }
    match /sampleReceipts/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('receiving.perform') || hasModuleAccess('charging.perform');
      allow create, update: if isQAStaff() || hasModuleAccess('receiving.perform') || hasModuleAccess('charging.perform');
      allow delete: if false;
    }
    match /controlSamples/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleCollections/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleObservations/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleWithdrawals/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleMovements/{docId} {
      allow read: if canControl();
      allow create: if canControl();
      allow update, delete: if false;
    }
    match /controlSampleDestructions/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleDestructionLogs/{docId} {
      allow read: if canControl();
      allow create: if canControl();
      allow update, delete: if false;
    }
    match /controlSampleTransactions/{docId} {
      allow read: if canControl();
      allow create: if canControl();
      allow update, delete: if false;
    }
    match /controlSampleLocations/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleBoxes/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleQuantityMasters/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleObservationParameters/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleHolds/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /controlSampleBoxCategories/{docId} {
      allow read: if canControl();
      allow create, update: if canControl();
      allow delete: if false;
    }
    match /analysisRequests/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('analysis.perform');
      allow create, update: if isQAStaff() || hasModuleAccess('analysis.perform') || hasModuleAccess('withdrawal.perform');
      allow delete: if false;
    }
    match /chamberAlarms/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create, update: if isQAManagerOrAdmin() || hasModuleAccess('chamber.ops');
      allow delete: if false;
    }
    match /chamberExcursions/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create, update: if isQAManagerOrAdmin() || hasModuleAccess('chamber.ops');
      allow delete: if false;
    }
    match /chamberCleaning/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberCalibration/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow update, delete: if false;
    }
    match /temperatureMappings/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberMaintenance/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberEvents/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow create: if isQAStaff() || hasModuleAccess('chamber.ops');
      allow update, delete: if false;
    }
    match /chamberDataLogs/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('chamber.ops') || hasModuleAccess('reports.view');
      allow create: if isQAManagerOrAdmin() || hasModuleAccess('chamber.ops');
      allow update, delete: if false;
    }
    match /electronicSignatures/{docId} {
      allow read: if isQAStaff();
      allow create: if isQAStaff() || hasModuleAccess('approve.records');
      allow update, delete: if false;
    }
    match /stabilityProtocols/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('protocol.manage');
      allow create, update: if isQAManagerOrAdmin() || hasModuleAccess('protocol.manage');
      allow delete: if false;
    }
    match /stabilityReports/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('protocol.manage');
      allow create, update: if isQAManagerOrAdmin() || hasModuleAccess('protocol.manage');
      allow delete: if false;
    }
    match /waterLossStudies/{docId} {
      allow read: if isQAStaff() || hasModuleAccess('protocol.manage');
      allow create: if isQAManagerOrAdmin() || hasModuleAccess('protocol.manage');
      allow update, delete: if false;
    }
    match /sopTasks/{docId} {
      allow read: if isQAStaff();
      allow write: if isQAStaff();
    }
  }
}
